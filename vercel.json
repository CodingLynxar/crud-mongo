{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    },
        
"experimentalServices"
:
 
{
        
"frontend"
:
 
{
            
"root"
:
 
"frontend"
,
            
"routePrefix"
:
 
"/"
,
            
"framework"
:
 
"create-react-app"
        
}
,
        
"backend"
:
 
{
            
"root"
:
 
"backend"
,
            
"routePrefix"
:
 
"/_/backend"
        
}
    
}
    {
      "src": "backend/api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ]
}
